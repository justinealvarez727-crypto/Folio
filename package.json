{
  "name": "folio-epub-reader",
  "private": true,
  "version": "1.0.0",
  "description": "Folio — an offline-first EPUB reader PWA with highlights and notes.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/make-sample.mjs",
    "dev": "vite",
    "prebuild": "node scripts/make-sample.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "framer-motion": "^11.11.0",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^4.2.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jszip": "^3.10.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-window": "^7.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
